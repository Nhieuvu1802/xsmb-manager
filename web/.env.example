NEXT_PUBLIC_API_URL=https://api.vvn.freedev.app/v1
WORKER_API_URL=https://xsmb-api.nhieuvu1802.workers.dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thongke24
ADMIN_API_KEY=replace-with-a-64-char-random-secret
CRON_SECRET=replace-with-a-32-char-random-secret
DATA_RETENTION_DAYS=370
BACKUP_API_URL=
BACKUP_SYNC_URL=
BACKUP_SYNC_API_KEY=

# Optional: licensed JSON API returning { "records": [...] } in the documented import format.
LOTTERY_PROVIDER_URL=
LOTTERY_PROVIDER_TOKEN=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://vvn.freedev.app

# GitHub raw URL for public data snapshots
GITHUB_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/Nhieuvu1802/xsmb-manager/main/public-data

# Android app
ANDROID_PACKAGE_ID=vn.xoso247.manager
# Comma-separated SHA-256 fingerprints from the upload/app-signing certificates.
ANDROID_SHA256_FINGERPRINTS=

# ── Upstash Redis (optional cache layer) ──
# Free tier: 256 MB, 10k commands/day
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry (error tracking) ──
# Free tier: 5k errors/month, 10k spans/month
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
