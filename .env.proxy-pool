# ══════════════════════════════════════════════════════════════════
# 9Router + Proxy Pool Configuration
# File này nằm cùng thư mục với compose.proxy-pool.yaml
# Chứa secrets / biến cấu hình cho proxy-rotate và 9Router
# ══════════════════════════════════════════════════════════════════

# ── 9Router Core ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/app/data
PORT=20128
NODE_ENV=production

# ── 9Router Security ─────────────────────────────────────────────
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# ── 9Router Cloud Sync ───────────────────────────────────────────
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ── Proxy Pool Settings ──────────────────────────────────────────
PROXY_POOL_URL=http://proxy-pool:5000
ROTATE_INTERVAL=300
MIN_SCORE=50
PROTOCOL_FILTER=http
PROXY_POOL_PORT=5000
NINEROUTER_PORT=20128

# ── Outbound Proxy (optional — filled by proxy-rotate sidecar) ───
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ── Provider API Keys (điền key của bạn) ────────────────────────
# Claude Code subscription (Tier 1 — Primary)
ANTHROPIC_API_KEY=

# OpenAI / Codex subscription (Tier 1)
OPENAI_API_KEY=

# GLM Coding — $0.60/1M tokens (Tier 2 — Cheap)
GLM_API_KEY=

# MiniMax — $0.20/1M tokens (Tier 2 — Cheap)
MINIMAX_API_KEY=

# Kimi — $9/tháng (Tier 2 — Cheap)
KIMI_API_KEY=

# iFlow — FREE (Tier 3 — Fallback)
IFLOW_API_KEY=

# Qwen — FREE (Tier 3 — Fallback)
QWEN_API_KEY=

# Kiro — FREE via AWS (Tier 3 — Fallback)
# Requires AWS credentials, configured via Dashboard

# Gemini — FREE (Tier 3 — Fallback)
GOOGLE_API_KEY=

# OpenRouter — FREE tier (Tier 3 — Fallback)
OPENROUTER_API_KEY=

# NVIDIA NIM — FREE (Tier 3 — Fallback)
NVIDIA_API_KEY=

# DeepSeek — Cheap (Tier 2 — Backup)
DEEPSEEK_API_KEY=

# xAI Grok
XAI_API_KEY=

# Mistral
MISTRAL_API_KEY=
